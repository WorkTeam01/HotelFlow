# Configuración de la Base de Datos
DB_HOST=localhost
DB_NAME=db_hotel_flow
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Configuración de la Aplicación
APP_NAME="HotelFlow"
APP_VERSION=1.2.0
APP_URL=http://localhost/HotelFlow/
TIMEZONE=America/La_Paz
DEBUG=false

# Rate-limiting de login (models/IntentoLogin.php)
LOGIN_RATE_LIMIT_VENTANA_MINUTOS=15
LOGIN_RATE_LIMIT_MAX_FALLOS_IDENTIFICADOR=5
LOGIN_RATE_LIMIT_MAX_FALLOS_IP=20
LOGIN_RATE_LIMIT_PURGA_HORAS=24

# Recepción: horas tras la hora de entrada prevista de una reserva no confirmada
# (estado 'reservado') para liberarla automáticamente como no-show
RECEPCION_NOSHOW_HORAS=6
